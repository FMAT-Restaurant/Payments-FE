# Base path of the Payments microservice behind the API Gateway (Kong).
VITE_API_BASE_URL=/api/v1/payments

# Auth microservice screens the module redirects to (401 and 403 PASSWORD_CHANGE_REQUIRED).
VITE_AUTH_LOGIN_URL=/login
VITE_AUTH_CHANGE_PASSWORD_URL=/cambiar-contrasena

# localStorage key where the App Shell / Auth leaves the JWT.
VITE_AUTH_TOKEN_STORAGE_KEY=access_token

# Development only: answer the API with Mock Service Worker and create a demo session.
VITE_API_MOCKS=false
# Role of the demo session: Administrador | Gerente | Cajero
VITE_MOCK_ROLE=Cajero

# Development only: forward /api to a real API Gateway or Payments-BE instead of using mocks.
# VITE_DEV_API_PROXY_TARGET=http://localhost:5000
